---
import Wordmark from './Wordmark.astro';
import { SITE } from '../config/site';

const links = [
  { href: '/#atmosfera', label: 'Atmosfera' },
  { href: '/#contatti', label: 'Contatti' },
];
---

<header class="nav" data-intro-reveal="0">
  <div class="nav__bar material">
    <a class="nav__brand" href="/#top" aria-label={`${SITE.name} — torna all'inizio`}>
      <span class="nav__mark"><Wordmark /></span>
    </a>

    <nav class="nav__links" aria-label="Principale">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
        <li>
          <a href={SITE.instagram.url} target="_blank" rel="noopener">
            Instagram
            <svg class="nav__ext" viewBox="0 0 12 12" aria-hidden="true"><path d="M3.5 8.5 8.5 3.5M4.5 3.5h4v4" /></svg>
            <span class="sr-only">(si apre in una nuova scheda)</span>
          </a>
        </li>
      </ul>
    </nav>

    <button
      class="nav__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="menu"
      data-menu-toggle
    >
      <span class="nav__toggle-label">Menu</span>
      <span class="nav__toggle-icon" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>

  <div class="menu-scrim" data-menu-scrim aria-hidden="true"></div>

  <div id="menu" class="menu material" data-menu data-state="closed" inert>
    <nav aria-label="Menu">
      <ul class="menu__list">
        {
          links.map((l) => (
            <li>
              <a class="menu__link" href={l.href} data-menu-link>
                {l.label}
              </a>
            </li>
          ))
        }
        <li>
          <a class="menu__link" href={SITE.instagram.url} target="_blank" rel="noopener" data-menu-link>
            Instagram
            <svg class="menu__ext" viewBox="0 0 12 12" aria-hidden="true"><path d="M3.5 8.5 8.5 3.5M4.5 3.5h4v4" /></svg>
            <span class="sr-only">(si apre in una nuova scheda)</span>
          </a>
        </li>
      </ul>
    </nav>
    <p class="menu__foot label">{SITE.city} · {SITE.region}</p>
  </div>
</header>

<script>
  import { initMenu } from '../scripts/menu';
  initMenu();
</script>

<style>
  .nav {
    position: fixed;
    inset: var(--nav-top) var(--gutter-r) auto var(--gutter-l);
    z-index: 40;
    pointer-events: none;
  }

  .nav__bar {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-h);
    padding-inline: var(--s-4) var(--s-1);
    border-radius: var(--r-l);
  }

  .nav__brand {
    display: flex;
    align-items: center;
    height: 44px;
    padding-inline: var(--s-1);
    margin-left: calc(var(--s-1) * -1);
    color: var(--c-white);
  }

  .nav__mark {
    display: block;
    width: 4.25rem;
  }

  .nav__links {
    display: none;
  }

  /* --- Menu toggle (mobile) ------------------------------------------ */

  .nav__toggle {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-width: 44px;
    height: 44px;
    padding-inline: var(--s-3);
    border-radius: var(--r-m);
    font-size: var(--fs-label);
    font-weight: 460;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--c-silver);
    transition: transform var(--d-press) var(--ease-out), color var(--d-fast) ease;
  }

  .nav__toggle:active {
    transform: scale(0.97);
  }

  .nav__toggle-icon {
    position: relative;
    width: 18px;
    height: 10px;
  }

  .nav__toggle-icon i {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    transition: transform var(--d-ui) var(--ease-in-out);
  }

  .nav__toggle-icon i:first-child {
    top: 2px;
  }

  .nav__toggle-icon i:last-child {
    bottom: 2px;
  }

  .nav__toggle[aria-expanded='true'] {
    color: var(--c-white);
  }

  .nav__toggle[aria-expanded='true'] .nav__toggle-icon i:first-child {
    transform: translateY(2.5px) rotate(45deg);
  }

  .nav__toggle[aria-expanded='true'] .nav__toggle-icon i:last-child {
    transform: translateY(-2.5px) rotate(-45deg);
  }

  /* --- Menu panel: emerges from the toggle (top-right origin) ----------- */

  .menu-scrim {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: rgb(8 9 11 / 0.55);
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--d-fast) var(--ease-out), visibility 0s linear var(--d-fast);
  }

  .menu {
    pointer-events: auto;
    position: absolute;
    top: calc(var(--nav-h) + var(--s-2));
    right: 0;
    width: min(100%, 22rem);
    padding: var(--s-2) var(--s-5) var(--s-5);
    border-radius: var(--r-l);
    transform-origin: calc(100% - 2.25rem) -0.5rem;
    opacity: 0;
    transform: translateY(-6px) scale(0.96);
    visibility: hidden;
    /* Exit is faster than entry: the system is responding, not presenting. */
    transition:
      opacity var(--d-fast) var(--ease-out),
      transform var(--d-fast) var(--ease-out),
      visibility 0s linear var(--d-fast);
  }

  .menu[data-state='open'] {
    opacity: 1;
    transform: none;
    visibility: visible;
    transition:
      opacity var(--d-ui) var(--ease-out),
      transform var(--d-ui) var(--ease-out),
      visibility 0s;
  }

  :global(html.menu-open) .menu-scrim {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity var(--d-ui) var(--ease-out), visibility 0s;
  }

:global(html.menu-open) {
    overflow: hidden;
  }

  .menu__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .menu__list li + li {
    border-top: 1px solid var(--c-line);
  }

  .menu__link {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 3.5rem;
    font-size: 1.375rem;
    font-weight: 320;
    letter-spacing: 0.005em;
    color: var(--c-white);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity var(--d-fast) var(--ease-out), transform var(--d-fast) var(--ease-out);
  }

  .menu[data-state='open'] .menu__link {
    opacity: 1;
    transform: none;
    transition: opacity var(--d-ui) var(--ease-out), transform var(--d-ui) var(--ease-out);
  }

  .menu[data-state='open'] li:nth-child(2) .menu__link {
    transition-delay: 40ms;
  }

  .menu[data-state='open'] li:nth-child(3) .menu__link {
    transition-delay: 80ms;
  }

  .menu__link:active {
    color: var(--c-silver);
  }

  .menu__ext,
  .nav__ext {
    width: 0.75em;
    height: 0.75em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.1;
  }

  .menu__ext {
    width: 0.6em;
    height: 0.6em;
    stroke-width: 0.9;
    color: var(--c-silver-dim);
  }

  .menu__foot {
    margin-top: var(--s-5);
    color: var(--c-silver-dim);
  }

  /* --- Desktop: inline links, no menu ----------------------------------- */

  @media (min-width: 900px) {
    .nav {
      left: 50%;
      right: auto;
      transform: translateX(-50%);
    }

    .nav__bar {
      gap: var(--s-7);
      padding-inline: var(--s-5) var(--s-2);
    }

    .nav__mark {
      width: 4.75rem;
    }

    .nav__links {
      display: block;
    }

    .nav__links ul {
      display: flex;
      gap: var(--s-1);
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .nav__links a {
      display: flex;
      align-items: center;
      gap: 0.35em;
      height: 44px;
      padding-inline: var(--s-4);
      border-radius: var(--r-m);
      font-size: var(--fs-label);
      font-weight: 460;
      letter-spacing: var(--track-label);
      text-transform: uppercase;
      color: var(--c-silver);
      transition: color var(--d-fast) ease, background-color var(--d-fast) ease;
    }

    .nav__toggle,
    .menu,
    .menu-scrim {
      display: none;
    }
  }

  @media (min-width: 900px) and (hover: hover) and (pointer: fine) {
    .nav__links a:hover {
      color: var(--c-white);
      background-color: rgb(242 240 237 / 0.05);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .nav__toggle:hover {
      color: var(--c-white);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu,
    .menu[data-state='open'],
    .menu__link,
    .menu[data-state='open'] .menu__link {
      transform: none;
      transition-property: opacity, visibility;
      transition-delay: 0s;
    }

    .nav__toggle-icon i {
      transition: none;
    }
  }
</style>
