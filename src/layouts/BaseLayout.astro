---
import '../styles/global.css';
import BrandSprite from '../components/BrandSprite.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  /** Plays the once-per-session intro. Only the home page uses it. */
  intro?: boolean;
  noindex?: boolean;
}

const {
  title = `${SITE.name} — ${SITE.tagline} a ${SITE.city}`,
  description = `${SITE.name}, ${SITE.tagline.toLowerCase()} a ${SITE.city}, ${SITE.region}. Dove ogni riflesso diventa atmosfera.`,
  intro = false,
  noindex = false,
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL('/brand/og.jpg', Astro.site).href : '/brand/og.jpg';
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#08090b" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/jost-latin-wght.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {
      intro && (
        <script is:inline>
          // Decide before first paint whether the intro plays, so the hero never flashes.
          // Once per tab session; never when arriving at an anchor or a restored scroll position.
          (function () {
            try {
              var seen = sessionStorage.getItem('glass:intro');
              if (!seen && !location.hash && window.scrollY === 0) {
                document.documentElement.setAttribute('data-intro', 'play');
              }
            } catch (e) {}
          })();
        </script>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#contenuto">Vai al contenuto</a>
    <BrandSprite />
    <slot name="intro" />
    <SiteNav />
    <main id="contenuto">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
